# Run setup.ps1 to configure privately on this computer.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Helper account phone, including + and country code; used by login.ps1.
TELEGRAM_PHONE=
OWNER_TELEGRAM_ID=
# Optional main personal username. Leave both OWNER fields empty to bind using /pair.
OWNER_TELEGRAM_USERNAME=
OPENAI_API_KEY=
# Up to 3 authorized backup keys, comma separated; transient failures only (not quota/429).
OPENAI_BACKUP_API_KEYS=
# auto selects Gemini when GEMINI_API_KEY is set, otherwise OpenAI.
TEXT_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REASONING_EFFORT=minimal
TEXT_MAX_OUTPUT_TOKENS=1200
HISTORY_MESSAGES=10
HISTORY_MAX_CHARS=10000
VOICE_MAX_OUTPUT_TOKENS=768
VOICE_CONTEXT_TOKENS=6000
TIMEZONE=Asia/Tashkent
TEXT_MODEL=gpt-4.1-mini
REALTIME_MODEL=gpt-realtime-2.1-mini
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
VOICE=marin
MAX_CALL_SECONDS=900
RING_TIMEOUT_SECONDS=35
REMINDER_GRACE_HOURS=24
# Conservative local controls, not Telegram-approved safe limits.
ENABLE_CONTACT_CALLS=false
ENABLE_VOICE_CALLS=false
ALLOWED_CALL_USER_IDS=
MIN_MESSAGE_INTERVAL_SECONDS=2
CALL_COOLDOWN_SECONDS=60
MAX_CALLS_PER_HOUR=3
# free = local Whisper STT + selected text AI + online Edge TTS (no OpenAI requests).
VOICE_PROVIDER=openai
LOCAL_STT_MODEL=small
FREE_TTS_VOICE=uz-UZ-MadinaNeural

# Record incoming original voice + full call; recordings stay local and are sent only to owner.
RECORD_CALLS=true
# Free local fallback when Gemini is unavailable; install using local-ai.ps1.
LOCAL_AI_FALLBACK=true
LOCAL_AI_MODEL=qwen3:4b-instruct
LOCAL_AI_URL=http://127.0.0.1:11434

# Prefer native Gemini audio transcription for Uzbek; quota fallback remains local.
GEMINI_AUDIO_ASR=true
