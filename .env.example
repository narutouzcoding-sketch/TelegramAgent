# Run setup.ps1 to configure privately on this computer.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Helper account phone, including + and country code; used by login.ps1.
TELEGRAM_PHONE=
OWNER_TELEGRAM_ID=
# Main personal account username; login.ps1 resolves and saves OWNER_TELEGRAM_ID.
OWNER_TELEGRAM_USERNAME=
OPENAI_API_KEY=
TIMEZONE=Asia/Tashkent
TEXT_MODEL=gpt-4.1-mini
REALTIME_MODEL=gpt-realtime-2.1
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=gpt-4o-mini-tts
VOICE=marin
MAX_CALL_SECONDS=900
RING_TIMEOUT_SECONDS=35
REMINDER_GRACE_HOURS=24
